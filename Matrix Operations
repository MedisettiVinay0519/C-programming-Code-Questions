Matrix addition 
#include<stdio.h>
#include<stdlib.h>
#include<string.h>
void matrix_add(int *a[m][n],int *b[k][p],int *res[m][n]){
    if (m==k && n==p){
        int res[m][n];
        for (int i=0;i<m;i++){
            for(j=0;j<n;j++){
                res[i][j]=a[i][j]+b[i][j];
            }
        }
    }
    else{
        printf("Matrix of unequal sizes cant be added");
    }
}
