Matrix addition 
#include<stdio.h>
#include<stdlib.h>
#include<string.h>
void matrix_add(int *a[m][n],int *b[k][p],int *res[m][n]){
    if (m==k && n==p){
        int res[m][n];
        for (int i=0;i<m;i++){
            for(j=0;j<n;j++){
                res[i][j]=a[i][j]+b[i][j];
            }
        }
    }
    else{
        printf("Matrix of unequal sizes cant be added");
    }
}
Matrix Multiplication:
#include<stdio.h>
#include<stdlib.h>
#include<string.h>
void matrix_mul(int *a[m][n],int *b[n][p],int *res[m][p]){
    for(int i=0;i<m;i++){
        for(int j=0;j<p;j++){
            for(int k=0,res[i][j]=0;k<n;k++){
                res[i][j]+=a[i][k]+b[k][i];
            }
        }
    }
    
}
Matrix Transpose:
void matrix_transpose(int *a[m][n],int *res[m][n]){
    for (int i=0;i<m;i++){
        for (int j=0;j<n;j++){
            res[j][i]=a[i][j];
        }
    }
}
