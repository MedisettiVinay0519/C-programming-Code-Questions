Matrix addition 
#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<math.h>
void matrix_add(int *a[m][n],int *b[k][p],int *res[m][n]){
    if (m==k && n==p){
        int res[m][n];
        for (int i=0;i<m;i++){
            for(j=0;j<n;j++){
                res[i][j]=a[i][j]+b[i][j];
            }
        }
    }
    else{
        printf("Matrix of unequal sizes cant be added");
    }
}
Matrix Multiplication:
#include<stdio.h>
#include<stdlib.h>
#include<string.h>
void matrix_mul(int *a[m][n],int *b[n][p],int *res[m][p]){
    for(int i=0;i<m;i++){
        for(int j=0;j<p;j++){
            for(int k=0,res[i][j]=0;k<n;k++){
                res[i][j]+=a[i][k]+b[k][i];
            }
        }
    }
    
}
Matrix Transpose:
void matrix_transpose(int *a[m][n],int *res[m][n]){
    for (int i=0;i<m;i++){
        for (int j=0;j<n;j++){
            res[j][i]=a[i][j];
        }
    }
}
Matrix Trace:
int matrix_trace(int *a[m][m]){
    int res=0;
    for (int i=0;i<m;i++){
        res+=a[i][i];
    }
    return res;
}
Matrix Norm Function
int matrix_norm(int *a[m][n]){
    int res=0;
    for(int i=0;i<m;i++){
        for(int j=0;j<n;j++){
            res=res+(a[i][j]*a[i][j]);
    }
}
res=sqrt(res);
return res;
}
void find_max_each_row(int *a[m][n]){
    for (int i=0;i<m;i++){
        int max=a[i][0];
        for (int j=0;j<n;j++){
            if max<a[i][j]{
                max=a[i][j];
            }
        
        printf(" max element in %d row is %d",i,max);
        }
    }
}
void find_max_each_col(int *a[m][n]){
    for (int j=0;j<n;j++){
        int max=a[0][j];
        for (int i=0;i<m;i++){
            if max<a[i][j]{
                max=a[i][j];
            }
        printf(" max element in %d column is %d",i,max);
        }
    }
}
void find_sum_each_row(int *a[m][n]){
    for (int i=0;i<m;i++){
        int sum=0
        for (int j=0;j<n;j++){
            sum+=a[i][j];
        }
        printf(" sum of element in %d row is %d",i,sum);
    }
}
void find_sum_each_col(int *a[m][n]){
    for(int j=0;j<n;j++){
        int sum=0;
        for (int i=0;i<m;i++){
            sum+=a[i][j];
        }
        printf(" sum of element in %d column is %d",j,sum);
    }
}
