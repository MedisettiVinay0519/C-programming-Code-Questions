#include<stdio.h>
#include<string.h>
#include<stdlib.h>
void del_extra_blank(char *string){
    int str_len=strlen(string);
    int j=0;
    bool last_char_not_space=true;
    for (int i=0;i<str_len;i++){
        if (string[i]!=' '||last_char_not_space){
            string[j]=string[i];
            j=j+1;
        }
        if (string[i]==' '){
            last_char_not_space=false;
        }
        else{
            last_char_not_space=true;
        }
    }
}
