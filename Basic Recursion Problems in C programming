Generate Fibnonacii Series of n intergers
// Online C compiler to run C program online
#include <stdio.h>
int fib_num(int n){
    if (n==0||n==1){
        return n;
    }
    else{
        return fib_num(n-1)+fib_num(n-2);
    }
}
int main() {
    // Write C code here
    int arr[10];
    int n=10;
    for (int i=0;i<n;i++){
        arr[i]=fib_num(i);
        printf("%d",arr[i]);
        /*or use printf("%d",fib_num(i));*/
    }

    return 0;
}
