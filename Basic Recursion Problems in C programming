Generate Fibnonacii Series of n intergers :
// Online C compiler to run C program online
#include <stdio.h>
int fib_num(int n){
    if (n==0||n==1){
        return n;
    }
    else{
        return fib_num(n-1)+fib_num(n-2);
    }
}
int main() {
    // Write C code here
    int arr[10];
    int n=10;
    for (int i=0;i<n;i++){
        arr[i]=fib_num(i);
        printf("%d",arr[i]);
        /*or use printf("%d",fib_num(i));*/
    }

    return 0;
}

Generate a factorial of a number n :
// Online C compiler to run C program online
#include <stdio.h>
int fact_num(int n){
    if (n==0||n==1){
        return n;
    }
    else{
        return n*fact_num(n-1);
    }
}
int main() {
    // Write C code here
    int arr[10];
    int n=10;
    for (int i=0;i<n;i++){
        arr[i]=fact_num(i);
        printf("%d",arr[i]);
        /*or use printf("%d",fact_num(i));*/
    }

    return 0;
}
Generating the sum of the digits of number:
#include<stdio.h>
int sum_digits(int n){
    static int sum;
    if (n==0){
        return sum;
    }
    else{
        sum=sum+n%10;
        n=n/10;
        return sum_digits(n);
    }
}
int main(){
    int k=1010;
    int sum;
    sum=sum_digits(k);
    printf("%d",sum);
}
Recursive approach to reverse a string:
#include<stdio.h>
#include<string.h>
void reversestr(char s[],int l,int r){
    if(l<r){
        char temp=s[l];
        s[l]=s[r];
        s[r]=temp;
        reversestr(s,l+1,r-1);
    }
}
int main(){
    char s[]="Hello World";
    int n=strlen(s);
    reversestr(s,0,n-1);
    printf("%s",s);
}
