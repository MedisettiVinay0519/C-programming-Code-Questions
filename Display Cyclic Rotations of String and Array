printf("Enter the size of the array");
scanf("%d",&n);
A=(int*)(malloc(sizeof(int)));
printf("Enter the numbers:");
for (i=0;i<n;i++){
  scanf("%d",A+i);
}
printf("The Entered Numbers are:")
for(i=0;i<n;i++){
    printf("%d",A[i]);
}
printf("The Cyclic rotations of the array of integers:");
for(i=0;i<n;i++){
  for(int j=0;j<n;j++){
      printf("%d",A[(i+j)%n]);
    }
      printf("\n");
  }
}
