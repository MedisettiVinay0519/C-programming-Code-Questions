#include<stdio.h>
#include<string.h>
int vowel_cnt(char str[]){
    int len=strlen(str);
    int cnt=0;
    for (int i=0;i<len;i++){
        switch(str[i]){
            case 'a':
            cnt++;
            break;
            case 'e':
            cnt++;
            break;
            case 'i':
            cnt++;
            break;
            case 'o':
            cnt++;
            break;
            case 'u':
            cnt++;
            break;
        }
    }
  return cnt;
}
