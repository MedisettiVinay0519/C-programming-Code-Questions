Bubble Sort: Method 1 
for (int i=0;i<n-1;i++){
  for (int j=0;j<n-1;j++){
        if (arr[j]>arr[j+1]){
            int temp=arr[j];
            arr[j]=arr[j+1];
            arr[j+1]=temp;
        }
    }
}

a liitle optimised one:
for (int i=0;i<n-1;i++){
  for (int j=0;j<n-1-i;j++){
        if (arr[j]>arr[j+1]){
            int temp=arr[j];
            arr[j]=arr[j+1];
            arr[j+1]=temp;
        }
    }
}

Selection sort:
for(int i=0;i<size-1;i++){
    int ind=i;
    for (int j=i+1;j<size;j++){
        if (arr[ind]>arr[j]){
            ind=j;
        }
    }
    int temp=arr[i];
    arr[i]=arr[ind];
    arr[ind]=temp;
}
  
